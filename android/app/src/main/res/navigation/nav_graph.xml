<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.gymmanager.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/membersFragment"
        android:name="com.gymmanager.ui.members.MembersFragment"
        android:label="Members"
        tools:layout="@layout/fragment_members">
        <action
            android:id="@+id/action_membersFragment_to_memberDetailFragment"
            app:destination="@id/memberDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/memberDetailFragment"
        android:name="com.gymmanager.ui.members.MemberDetailFragment"
        android:label="Member Detail"
        tools:layout="@layout/fragment_member_detail">
        <argument
            android:name="memberId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/attendanceFragment"
        android:name="com.gymmanager.ui.attendance.AttendanceFragment"
        android:label="Attendance"
        tools:layout="@layout/fragment_attendance" />

    <!-- ── Bottom Nav: More (Master) ─────────────────────────────────────── -->
    <fragment
        android:id="@+id/masterFragment"
        android:name="com.gymmanager.ui.master.MasterFragment"
        android:label="More"
        tools:layout="@layout/fragment_master">
        <action
            android:id="@+id/action_masterFragment_to_expensesFragment"
            app:destination="@id/expensesFragment" />
        <action
            android:id="@+id/action_masterFragment_to_staffFragment"
            app:destination="@id/staffFragment" />
        <action
            android:id="@+id/action_masterFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- ── Sub-screens from Master ───────────────────────────────────────── -->
    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.gymmanager.ui.expenses.ExpensesFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_expenses" />

    <fragment
        android:id="@+id/staffFragment"
        android:name="com.gymmanager.ui.staff.StaffFragment"
        android:label="Staff"
        tools:layout="@layout/fragment_staff" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.gymmanager.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
