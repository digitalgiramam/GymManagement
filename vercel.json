{
  "version": 2,
  "buildCommand": "cd backend && npm install && ./node_modules/.bin/prisma generate",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
