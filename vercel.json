{
  "version": 2,
  "installCommand": "npm install && ./node_modules/.bin/prisma generate --schema=backend/prisma/schema.prisma",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/**,node_modules/@prisma/engines/**"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
