# Neon PostgreSQL connection string (get from Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/gymdb?sslmode=require"

# JWT secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-secure-random-secret"

# Server port (ignored on Vercel serverless, used for local dev)
PORT=3000
